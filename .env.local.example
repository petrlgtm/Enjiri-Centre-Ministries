# Sanity CMS Configuration
# Create a project at https://www.sanity.io/ and fill in these values
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (server-side only, for authenticated requests)
SANITY_API_TOKEN=

# YouTube Data API v3 Key
# Used for fetching sermon videos from YouTube (server-side only)
YOUTUBE_API_KEY=

# Resend (contact form + newsletter emails) — server-side only
# Sending domain enjiricenterministries.org must be verified in Resend
RESEND_API_KEY=
# Optional overrides
EMAIL_FROM="Enjiri Center Ministries <hello@enjiricenterministries.org>"
CONTACT_INBOX=enjiricenter@gmail.com
# Optional: Resend audience ID to collect newsletter subscribers
RESEND_AUDIENCE_ID=
